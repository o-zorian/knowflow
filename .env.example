# Development-only defaults. Replace every credential before non-local use.
APP_ENV=development
HTTP_ADDR=:8080
HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=knowflow-dev-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://knowflow:knowflow-dev-password@postgres:5432/knowflow?sslmode=disable
DATABASE_MAX_CONNS=10

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=knowflow-dev
MINIO_SECRET_KEY=knowflow-dev-password
MINIO_BUCKET=knowflow
MINIO_USE_SSL=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

JWT_SECRET=development-only-jwt-secret-change-before-production

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

MAX_UPLOAD_SIZE_MB=30
LOG_LEVEL=info
STARTUP_TIMEOUT=30s
HEALTH_CHECK_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
WORKER_HEALTH_INTERVAL=30s
