# Development-only defaults. Replace every credential before non-local use.
APP_ENV=development
HTTP_ADDR=:8080
HTTP_PORT=8080
WEB_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEB_API_BASE_URL=http://localhost:8080/api/v1

POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=knowflow-dev-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://knowflow:knowflow-dev-password@postgres:5432/knowflow?sslmode=disable
DATABASE_MAX_CONNS=10

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=knowflow-dev
MINIO_SECRET_KEY=knowflow-dev-password
MINIO_BUCKET=knowflow
MINIO_USE_SSL=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

JWT_SECRET=development-only-jwt-secret-change-before-production
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=720h

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
# Rerank provider: openai-compatible or vikingdb. Leave the entire group empty
# to use the deterministic fake reranker in development.
RERANK_PROVIDER=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
VIKINGDB_AK=
VIKINGDB_SK=
VIKINGDB_HOST=api-knowledgebase.mlp.cn-beijing.volces.com
VIKINGDB_REGION=cn-beijing
MODEL_MAX_RETRIES=3

# Provider pricing is deployment-owned and expressed in USD per one million tokens.
CHAT_INPUT_COST_PER_MILLION_USD=0
CHAT_OUTPUT_COST_PER_MILLION_USD=0
EMBEDDING_COST_PER_MILLION_USD=0
RERANK_COST_PER_MILLION_USD=0

# Offline report-only illustrative rates; override with your provider prices.
EVAL_CHAT_INPUT_COST_PER_MILLION_USD=0.15
EVAL_CHAT_OUTPUT_COST_PER_MILLION_USD=0.60
EVAL_EMBEDDING_COST_PER_MILLION_USD=0.02
EVAL_RERANK_COST_PER_MILLION_USD=0.05

RATE_LIMIT_IP_PER_MINUTE=300
RATE_LIMIT_USER_PER_MINUTE=120
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW=15m

MAX_UPLOAD_SIZE_MB=30
LOG_LEVEL=info
STARTUP_TIMEOUT=30s
HEALTH_CHECK_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
WORKER_HEALTH_INTERVAL=30s
WORKER_POLL_TIMEOUT=2s
INGESTION_JOB_TIMEOUT=10m
